{
  "id": "java",
  "languages": ["java", "kotlin", "scala", "groovy"],
  "commentPrefixes": ["//", "/*", "*"],
  "functionPatterns": [
    "^(?!\\s*(?:return|new|else|throw|case|if|for|while|switch|catch|do|try)\\b)\\s*(?:@\\w+(?:\\([^)]*\\))?\\s+)*(?:(?:public|private|protected|static|final|synchronized|abstract|native|default|override|suspend|open|internal|inline|operator)\\s+)*(?:fun\\s+|def\\s+)?(?:<[^>]*>\\s*)?(?:[\\w.\\[\\]<>?,]+\\s+)?(?<name>[A-Za-z_]\\w*)\\s*\\([^=;]*$"
  ],
  "classPatterns": [
    "\\b(?:class|interface|enum|record|object|trait)\\s+(?<name>[A-Za-z_]\\w*)"
  ],
  "rules": [
    {
      "id": "java.jca.cipher",
      "pattern": "\\b(?<api>Cipher)\\s*\\.\\s*getInstance\\s*\\(\\s*{ARG}",
      "map": {
        "aes": "AES/ECB/PKCS5Padding",
        "des": "DES/ECB/PKCS5Padding",
        "desede": "DESede/ECB/PKCS5Padding",
        "tripledes": "DESede/ECB/PKCS5Padding",
        "blowfish": "Blowfish/ECB/PKCS5Padding",
        "rsa": "RSA/ECB/PKCS1Padding"
      },
      "functions": ["encrypt", "decrypt"]
    },
    {
      "id": "java.jca.get-instance",
      "pattern": "\\b(?<api>Cipher|MessageDigest|Mac|Signature|KeyGenerator|KeyPairGenerator|SecretKeyFactory|KeyAgreement|KeyFactory|AlgorithmParameters|AlgorithmParameterGenerator|SecureRandom|SSLContext|KEM)\\s*\\.\\s*getInstance\\s*\\(\\s*{ARG}",
      "functionsByApi": {
        "Cipher": ["encrypt", "decrypt"],
        "MessageDigest": ["digest"],
        "Mac": ["tag"],
        "Signature": ["sign", "verify"],
        "KeyGenerator": ["keygen"],
        "KeyPairGenerator": ["keygen"],
        "SecretKeyFactory": ["keyderive"],
        "KeyAgreement": ["other"],
        "KeyFactory": ["other"],
        "AlgorithmParameters": ["other"],
        "AlgorithmParameterGenerator": ["generate"],
        "SecureRandom": ["generate"],
        "SSLContext": ["other"],
        "KEM": ["encapsulate", "decapsulate"]
      },
      "primitiveByApi": {
        "Signature": "signature",
        "KeyAgreement": "key-agree",
        "Mac": "mac",
        "MessageDigest": "hash",
        "SecureRandom": "drbg",
        "KEM": "kem"
      },
      "keyByApi": { "KeyGenerator": "secret-key", "KeyPairGenerator": "private-key" }
    },
    {
      "id": "java.jca.secret-key-spec",
      "pattern": "\\bnew\\s+(?:[\\w.]+\\.)?SecretKeySpec\\s*\\((?:[^;()]|\\([^()]*\\))*?,\\s*{ARG}\\s*\\)",
      "functions": ["other"]
    },
    {
      "id": "java.jca.ec-gen-parameter-spec",
      "pattern": "\\bnew\\s+ECGenParameterSpec\\s*\\(\\s*{ARG}",
      "template": "EC-{algo}",
      "functions": ["keygen"]
    },
    {
      "id": "java.jca.named-parameter-spec",
      "pattern": "\\bNamedParameterSpec\\s*\\.\\s*(?<name>X25519|X448|ED25519|ED448)\\b",
      "functions": ["keygen"]
    },
    {
      "id": "java.jsse.enabled-protocols",
      "pattern": "\\bsetEnabledProtocols\\s*\\(\\s*(?:new\\s+String\\s*\\[\\s*\\]\\s*)?(?:arrayOf\\s*\\()?\\{?(?<list>[^})]*)",
      "skipUnrecognized": true,
      "functions": ["other"]
    },
    {
      "id": "java.jsse.protocol-property",
      "pattern": "\"(?:https\\.protocols|jdk\\.tls\\.client\\.protocols|jdk\\.tls\\.server\\.protocols)\"\\s*,\\s*\"(?<list>[^\"]+)\"",
      "skipUnrecognized": true,
      "functions": ["other"]
    },
    {
      "id": "java.tink.generate",
      "pattern": "\\bKeysetHandle\\s*\\.\\s*generateNew\\s*\\(\\s*(?:KeyTemplates\\s*\\.\\s*get\\s*\\(\\s*\\\"|(?:\\w+\\s*\\.\\s*)*)(?<name>[A-Z][A-Z0-9_]+)",
      "functions": ["keygen"],
      "key": "auto"
    },
    {
      "id": "java.nimbus.keygen",
      "pattern": "\\bnew\\s+(?<name>RSA|EC)KeyGenerator\\s*\\(\\s*(?:{SIZE}|Curve\\s*\\.\\s*(?<curve>P_256|P_384|P_521|SECP256K1))?",
      "map": { "p_256": "P-256", "p_384": "P-384", "p_521": "P-521" },
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "java.jjwt.key",
      "pattern": "\\b(?:Jwts\\s*\\.\\s*SIG\\s*\\.\\s*(?=\\w+\\s*\\.\\s*key(?:Pair)?\\s*\\()|Keys\\s*\\.\\s*(?:secretKeyFor|keyPairFor)\\s*\\(\\s*SignatureAlgorithm\\s*\\.\\s*)(?<name>HS256|HS384|HS512|RS256|RS384|RS512|PS256|PS384|PS512|ES256|ES384|ES512|EdDSA)\\b",
      "map": {
        "rs256": "RSA",
        "rs384": "RSA",
        "rs512": "RSA",
        "ps256": "RSA",
        "ps384": "RSA",
        "ps512": "RSA",
        "es256": "ECDSA-P-256",
        "es384": "ECDSA-P-384",
        "es512": "ECDSA-P-521",
        "hs256": "HMAC-SHA-256",
        "hs384": "HMAC-SHA-384",
        "hs512": "HMAC-SHA-512"
      },
      "functions": ["keygen"],
      "key": "auto"
    },
    {
      "id": "java.bc.block-cipher-mode",
      "pattern": "\\bnew\\s+(?<mode>CBC|GCM|CCM|CTR|SIC|CFB|OFB|EAX|OCB|KCCM|KGCM)BlockCipher\\s*\\(\\s*(?:new\\s+)?(?<name>AES|DES|DESede|Blowfish|Twofish|Serpent|Camellia|CAST5|CAST6|IDEA|SEED|SM4|ARIA|RC2|RC6|Noekeon|Threefish)Engine",
      "functions": ["encrypt", "decrypt"]
    },
    {
      "id": "java.bc.engine",
      "pattern": "\\bnew\\s+(?<name>AES|AESFast|AESLight|DES|DESede|Blowfish|Twofish|Serpent|Camellia|CAST5|CAST6|IDEA|SEED|SM4|ARIA|RC2|RC4|RC532|RC564|RC6|ChaCha|ChaCha7539|XSalsa20|Salsa20|Noekeon|Threefish|TEA|XTEA)Engine\\s*\\(",
      "map": { "aesfast": "AES", "aeslight": "AES", "chacha7539": "ChaCha20", "rc532": "RC5", "rc564": "RC5" },
      "functions": ["encrypt", "decrypt"]
    },
    {
      "id": "java.bc.hmac",
      "pattern": "\\bnew\\s+HMac\\s*\\(\\s*new\\s+(?<name>\\w+?)Digest\\s*\\(",
      "template": "HMAC-{name}",
      "functions": ["tag"]
    },
    {
      "id": "java.bc.digest",
      "pattern": "\\bnew\\s+(?<name>SHA1|SHA224|SHA256|SHA384|SHA512|SHA512t|SHA3|SHAKE|MD2|MD4|MD5|RIPEMD128|RIPEMD160|RIPEMD256|RIPEMD320|Blake2b|Blake2s|Blake3|SM3|Keccak|Whirlpool|Tiger|GOST3411)Digest\\s*\\(",
      "functions": ["digest"]
    },
    {
      "id": "java.bc.key-pair-generator",
      "pattern": "\\bnew\\s+(?<name>RSA|EC|Ed25519|Ed448|X25519|X448|DSA|DH|ElGamal|GOST3410|SM2|MLKEM|MLDSA|SLHDSA|Kyber|Dilithium|SPHINCSPlus|Falcon)KeyPairGenerator\\s*\\(",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "java.bc.signer",
      "pattern": "\\bnew\\s+(?<name>RSA|PSS|ECDSA|DSA|Ed25519|Ed448|SM2|MLDSA|SLHDSA|Dilithium|Falcon)Signer\\s*\\(",
      "map": { "pss": "RSASSA-PSS" },
      "primitive": "signature",
      "functions": ["sign", "verify"]
    },
    {
      "id": "java.jca.name-literal",
      "pattern": "\"(?<name>(?:AES|DES|DESede|TripleDES|RC2|RC4|ARCFOUR|Blowfish|IDEA|RSA)/\\w+/[\\w-]+|AES|DES|DESede|TripleDES|RC2|RC4|ARCFOUR|Blowfish|RSA|MD2|MD4|MD5|SHA-?1|SHA-(?:224|256|384|512)|SHA3-(?:224|256|384|512)|Hmac(?:MD5|SHA1|SHA224|SHA256|SHA384|SHA512)|(?:MD2|MD5|SHA1|SHA224|SHA256|SHA384|SHA512)with(?:RSA|DSA|ECDSA))\"",
      "fallback": true
    },
    {
      "id": "java.jca.keysize.initialize",
      "kind": "keysize",
      "pattern": "\\.\\s*(?:initialize|init)\\s*\\(\\s*{SIZE}\\b"
    },
    {
      "id": "java.jca.keysize.rsa-spec",
      "kind": "keysize",
      "pattern": "\\bnew\\s+RSAKeyGenParameterSpec\\s*\\(\\s*{SIZE}\\b"
    },
    {
      "id": "java.pqc.parameter-set",
      "kind": "keysize",
      "pattern": "\\b(?:MLKEMParameters\\s*\\.\\s*ml_kem_|MLDSAParameters\\s*\\.\\s*ml_dsa_|NamedParameterSpec\\s*\\.\\s*ML_(?:KEM|DSA)_)(?<size>\\d{2,4})\\b"
    },
    {
      "id": "java.random-key-bytes",
      "kind": "keybytes",
      "pattern": "\\b(?<var>(?i:\\w{0,40}key\\w{0,40}))\\s*=\\s*(?:new\\s+byte\\s*\\[|ByteArray\\s*\\()\\s*(?<size>16|24|32)\\s*[\\])][\\s\\S]{0,300}?\\.\\s*nextBytes\\s*\\(\\s*\\k<var>\\s*\\)"
    },
    {
      "id": "java.io.write",
      "kind": "file",
      "direction": "write",
      "pattern": "\\bnew\\s+(?:[\\w.]+\\.)?(?:FileOutputStream|FileWriter|PrintWriter|RandomAccessFile)\\s*\\(\\s*(?:new\\s+(?:[\\w.]+\\.)?File\\s*\\(\\s*)?{FILE}"
    },
    {
      "id": "java.nio.write",
      "kind": "file",
      "direction": "write",
      "pattern": "\\bFiles\\s*\\.\\s*(?:write|writeString|newOutputStream|newBufferedWriter)\\s*\\(\\s*(?:Paths?\\s*\\.\\s*(?:get|of)\\s*\\(\\s*)?{FILE}"
    },
    {
      "id": "java.io.read",
      "kind": "file",
      "direction": "read",
      "pattern": "\\bnew\\s+(?:[\\w.]+\\.)?(?:FileInputStream|FileReader|Scanner)\\s*\\(\\s*(?:new\\s+(?:[\\w.]+\\.)?File\\s*\\(\\s*)?{FILE}"
    },
    {
      "id": "java.nio.read",
      "kind": "file",
      "direction": "read",
      "pattern": "\\bFiles\\s*\\.\\s*(?:readAllBytes|readString|readAllLines|lines|newInputStream|newBufferedReader)\\s*\\(\\s*(?:Paths?\\s*\\.\\s*(?:get|of)\\s*\\(\\s*)?{FILE}"
    }
  ]
}
