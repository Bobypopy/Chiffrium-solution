{
  "id": "config",
  "languages": ["config"],
  "commentPrefixes": ["#", ";", "//"],
  "functionPatterns": [],
  "classPatterns": [],
  "rules": [
    {
      "id": "config.nginx.ssl-protocols",
      "pattern": "\\bssl_protocols\\s+(?<list>[^;\\n]+)",
      "skipUnrecognized": true,
      "functions": ["other"]
    },
    {
      "id": "config.apache.ssl-protocol",
      "pattern": "\\bSSLProtocol\\s+(?<list>[^\\n]+)",
      "skipUnrecognized": true,
      "functions": ["other"]
    },
    {
      "id": "config.enabled-protocols",
      "pattern": "\\b(?:enabled-protocols|enabledProtocols|ssl-protocols|tls-versions?|min-tls-version|minimum-tls-version|tls_min_version|min_version)\\s*[:=]\\s*(?<list>[^\\n#]+)",
      "skipUnrecognized": true,
      "functions": ["other"]
    },
    {
      "id": "config.algorithm-setting",
      "pattern": "\\b(?:signature|hash|digest|cipher|encryption|key)[-_.]?(?:algorithm|algo)\\s*[:=]\\s*['\"]?(?<name>[\\w./-]+)",
      "skipUnrecognized": true,
      "functions": ["other"]
    },
    {
      "id": "config.openssl.genrsa",
      "pattern": "\\bopenssl\\s+genrsa\\b(?=(?:[^\\n|;&]*\\s(?<size>\\d{3,5})\\b)?)",
      "algorithm": "RSA",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.openssl.genpkey",
      "pattern": "\\bopenssl\\s+genpkey\\b(?=[^\\n|;&]*?\\s-algorithm\\s+(?<name>[\\w-]+))(?=(?:[^\\n|;&]*?rsa_keygen_bits:(?<size>\\d{3,5}))?)(?=(?:[^\\n|;&]*?ec_paramgen_curve:(?<curve>[\\w-]+))?)",
      "functions": ["keygen"],
      "key": "auto"
    },
    {
      "id": "config.openssl.req-newkey",
      "pattern": "\\bopenssl\\s+req\\b(?=[^\\n|;&]*?\\s-newkey\\s+(?<name>rsa|ec|ed25519|ed448|ml-dsa-\\d{2})(?::(?<size>\\d{3,5}))?)(?=(?:[^\\n|;&]*?ec_paramgen_curve:(?<curve>[\\w-]+))?)",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.openssl.ecparam",
      "pattern": "\\bopenssl\\s+ecparam\\b(?=[^\\n|;&]*?\\s-genkey\\b)(?=[^\\n|;&]*?\\s-name\\s+(?<curve>[\\w-]+))",
      "algorithm": "EC",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.ssh-keygen",
      "pattern": "\\bssh-keygen\\b(?=[^\\n|;&]*?\\s-t\\s+(?<name>ecdsa-sk|ed25519-sk|rsa|dsa|ecdsa|ed25519)\\b)(?=(?:[^\\n|;&]*?\\s-b\\s+(?<size>\\d{3,5}))?)",
      "map": { "ecdsa-sk": "ECDSA", "ed25519-sk": "Ed25519" },
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.keytool.genkeypair",
      "pattern": "\\bkeytool\\b(?=[^\\n|;&]*?\\s-genkey(?:pair)?\\b)(?=[^\\n|;&]*?\\s-keyalg\\s+(?<name>\\w+))(?=(?:[^\\n|;&]*?\\s-keysize\\s+(?<size>\\d{3,5}))?)(?=(?:[^\\n|;&]*?\\s-groupname\\s+(?<curve>[\\w-]+))?)",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.keytool.genseckey",
      "pattern": "\\bkeytool\\b(?=[^\\n|;&]*?\\s-genseckey\\b)(?=[^\\n|;&]*?\\s-keyalg\\s+(?<name>\\w+))(?=(?:[^\\n|;&]*?\\s-keysize\\s+(?<size>\\d{2,5}))?)",
      "functions": ["keygen"],
      "key": "secret-key"
    },
    {
      "id": "config.gpg.quick-gen-key",
      "pattern": "\\bgpg2?\\b(?=[^\\n|;&]*?--quick-gen(?:erate)?-key\\b)(?=[^\\n|;&]*?\\s(?<name>rsa|dsa|ed25519|ed448|cv25519|nistp256|nistp384|nistp521)(?<size>\\d{3,5})?\\b)",
      "map": {
        "cv25519": "X25519",
        "nistp256": "ECDSA-P-256",
        "nistp384": "ECDSA-P-384",
        "nistp521": "ECDSA-P-521"
      },
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.terraform.tls-private-key",
      "pattern": "\\bresource\\s+\\\"tls_private_key\\\"\\s+\\\"[\\w-]+\\\"\\s*\\{(?=[^}]*?\\balgorithm\\s*=\\s*\\\"(?<name>RSA|ECDSA|ED25519)\\\")(?=(?:[^}]*?\\brsa_bits\\s*=\\s*(?<size>\\d{3,5}))?)(?=(?:[^}]*?\\becdsa_curve\\s*=\\s*\\\"(?<curve>P224|P256|P384|P521)\\\")?)",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.terraform.azure-key-vault-key",
      "pattern": "\\bresource\\s+\\\"azurerm_key_vault_key\\\"\\s+\\\"[\\w-]+\\\"\\s*\\{(?=[^}]*?\\bkey_type\\s*=\\s*\\\"(?<name>RSA-HSM|RSA|EC-HSM|EC)\\\")(?=(?:[^}]*?\\bkey_size\\s*=\\s*(?<size>\\d{3,5}))?)(?=(?:[^}]*?\\bcurve\\s*=\\s*\\\"(?<curve>[\\w-]+)\\\")?)",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.cert-manager.private-key",
      "pattern": "\\bprivateKey\\s*:[ \\t]*\\r?\\n(?=(?:[ \\t]+[^\\n]*\\n){0,6}?[ \\t]+algorithm\\s*:\\s*['\\\"]?(?<name>RSA|ECDSA|Ed25519)\\b)(?=(?:(?:[ \\t]+[^\\n]*\\n){0,6}?[ \\t]+size\\s*:\\s*(?<size>\\d{3,5}))?)",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.powershell.self-signed-certificate",
      "pattern": "\\bNew-SelfSignedCertificate\\b(?=(?:[^\\n|;`]|`\\r?\\n){0,400}?\\s-KeyAlgorithm\\s+['\\\"]?(?<name>[\\w-]+))(?=(?:(?:[^\\n|;`]|`\\r?\\n){0,400}?\\s-KeyLength\\s+(?<size>\\d{3,5}))?)",
      "map": { "ecdsa_nistp256": "ECDSA-P-256", "ecdsa_nistp384": "ECDSA-P-384", "ecdsa_nistp521": "ECDSA-P-521" },
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.powershell.self-signed-certificate-default",
      "pattern": "\\bNew-SelfSignedCertificate\\b(?=(?:(?:[^\\n|;`]|`\\r?\\n){0,400}?\\s-KeyLength\\s+(?<size>\\d{3,5}))?)",
      "algorithm": "RSA",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.ansible.private-key",
      "pattern": "\\b(?:community\\.crypto\\.)?(?:openssl_privatekey(?:_pipe)?|openssh_keypair)\\s*:[ \\t]*\\r?\\n(?=(?:[ \\t]+[^\\n]*\\n){0,8}?[ \\t]+type\\s*:\\s*['\\\"]?(?<name>RSA|DSA|ECC|ECDSA|Ed25519|Ed448|X25519|X448|rsa|dsa|ecdsa|ed25519)\\b)(?=(?:(?:[ \\t]+[^\\n]*\\n){0,8}?[ \\t]+size\\s*:\\s*(?<size>\\d{3,5}))?)(?=(?:(?:[ \\t]+[^\\n]*\\n){0,8}?[ \\t]+curve\\s*:\\s*['\\\"]?(?<curve>[\\w-]+))?)",
      "map": { "ecc": "EC" },
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.ansible.private-key-default",
      "pattern": "\\b(?:community\\.crypto\\.)?(?:openssl_privatekey(?:_pipe)?|openssh_keypair)\\s*:[ \\t]*\\r?\\n(?=(?:(?:[ \\t]+[^\\n]*\\n){0,8}?[ \\t]+size\\s*:\\s*(?<size>\\d{3,5}))?)",
      "algorithm": "RSA",
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "config.vault.transit-key",
      "pattern": "\\bvault\\s+write\\b[^\\n|;&]*?\\btransit/keys/[\\w.-]+(?![\\w./-])(?=[^\\n|;&]*?\\btype=['\\\"]?(?<name>[\\w-]+))",
      "functions": ["keygen"],
      "key": "auto"
    },
    {
      "id": "config.vault.transit-key-default",
      "pattern": "\\bvault\\s+write\\b[^\\n|;&]*?\\btransit/keys/[\\w.-]+(?![\\w./-])",
      "algorithm": "AES-256-GCM",
      "functions": ["keygen"],
      "key": "secret-key"
    },
    {
      "id": "config.terraform.vault-transit-key",
      "pattern": "\\bresource\\s+\\\"vault_transit_secret_backend_key\\\"\\s+\\\"[\\w-]+\\\"\\s*\\{(?=[^}]*?\\btype\\s*=\\s*\\\"(?<name>[\\w-]+)\\\")",
      "functions": ["keygen"],
      "key": "auto"
    },
    {
      "id": "config.terraform.vault-transit-key-default",
      "pattern": "\\bresource\\s+\\\"vault_transit_secret_backend_key\\\"\\s+\\\"[\\w-]+\\\"\\s*\\{",
      "algorithm": "AES-256-GCM",
      "functions": ["keygen"],
      "key": "secret-key"
    },
    {
      "id": "config.openssl.protocol",
      "pattern": "(?m)^\\s*(?:MinProtocol|MaxProtocol)\\s*=\\s*(?<list>[^\\n#]+)",
      "skipUnrecognized": true,
      "functions": ["other"]
    },
    {
      "id": "config.ipsec.proposals",
      "pattern": "(?m)^\\s*(?:ike|esp|ah|phase2alg|proposals|esp_proposals|ah_proposals)\\s*=\\s*(?<list>[^\\n#]+)",
      "listSeparator": "[\\s,;:!+-]+",
      "map": {"aes128": "AES-128", "aes192": "AES-192", "aes256": "AES-256", "aes128gcm16": "AES-128-GCM", "aes256gcm16": "AES-256-GCM", "aes128gcm": "AES-128-GCM", "aes256gcm": "AES-256-GCM", "aes128ctr": "AES-128-CTR", "aes256ctr": "AES-256-CTR", "3des": "3DES", "des": "DES", "blowfish": "Blowfish", "cast128": "CAST5", "chacha20poly1305": "ChaCha20-Poly1305", "md5": "HMAC-MD5", "sha1": "HMAC-SHA-1", "sha": "HMAC-SHA-1", "sha256": "HMAC-SHA-256", "sha384": "HMAC-SHA-384", "sha512": "HMAC-SHA-512", "sha2_256": "HMAC-SHA-256", "prfmd5": "HMAC-MD5", "prfsha1": "HMAC-SHA-1", "prfsha256": "HMAC-SHA-256", "prfsha384": "HMAC-SHA-384", "prfsha512": "HMAC-SHA-512", "modp768": "DH-768", "modp1024": "DH-1024", "modp1536": "DH-1536", "modp2048": "DH-2048", "modp3072": "DH-3072", "modp4096": "DH-4096", "modp6144": "DH-6144", "modp8192": "DH-8192", "ecp256": "ECDH-P-256", "ecp384": "ECDH-P-384", "ecp521": "ECDH-P-521", "x25519": "X25519", "curve25519": "X25519", "x448": "X448", "curve448": "X448", "mlkem768": "ML-KEM-768", "mlkem1024": "ML-KEM-1024", "mlkem512": "ML-KEM-512"},
      "skipUnrecognized": true,
      "functions": ["other"]
    }
  ]
}
