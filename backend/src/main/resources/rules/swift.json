{
  "id": "swift",
  "languages": ["swift"],
  "commentPrefixes": ["//", "/*", "*"],
  "functionPatterns": [
    "\\bfunc\\s+(?<name>\\w+)"
  ],
  "classPatterns": [
    "\\b(?:class|struct|enum|extension|actor)\\s+(?<name>\\w+)"
  ],
  "rules": [
    { "id": "swift.cryptokit.insecure", "pattern": "\\bInsecure\\s*\\.\\s*(?<name>MD5|SHA1)\\b", "functions": ["digest"] },
    { "id": "swift.cryptokit.hmac", "pattern": "\\bHMAC\\s*<\\s*(?:Insecure\\s*\\.\\s*)?(?<name>SHA256|SHA384|SHA512|MD5|SHA1)\\s*>", "template": "HMAC-{name}", "functions": ["tag"] },
    { "id": "swift.cryptokit.hkdf", "pattern": "\\bHKDF\\s*<\\s*(?<name>SHA\\d+)\\s*>", "template": "HKDF-{name}", "functions": ["keyderive"] },
    { "id": "swift.cryptokit.hash", "pattern": "\\b(?<name>SHA256|SHA384|SHA512)\\s*\\.\\s*hash\\s*\\(", "functions": ["digest"] },
    { "id": "swift.cryptokit.aes", "pattern": "\\bAES\\s*\\.\\s*(?<mode>GCM|KeyWrap)\\s*\\.\\s*(?<op>seal|open|wrap|unwrap)\\b", "algorithm": "AES" },
    { "id": "swift.cryptokit.chachapoly", "pattern": "\\bChaChaPoly\\s*\\.\\s*(?<op>seal|open)\\b", "algorithm": "ChaCha20-Poly1305" },
    { "id": "swift.cryptokit.ml-kem", "pattern": "\\bMLKEM(?<bits>768|1024)\\s*\\.\\s*PrivateKey\\s*\\(\\s*\\)", "template": "ML-KEM-{bits}", "functions": ["keygen"], "key": "private-key" },
    { "id": "swift.cryptokit.ml-dsa", "pattern": "\\bMLDSA(?<bits>65|87)\\s*\\.\\s*PrivateKey\\s*\\(\\s*\\)", "template": "ML-DSA-{bits}", "functions": ["keygen"], "key": "private-key" },
    { "id": "swift.cryptokit.x-wing", "pattern": "\\bXWingMLKEM768X25519\\s*\\.\\s*PrivateKey\\s*\\(\\s*\\)", "algorithm": "X-Wing", "functions": ["keygen"], "key": "private-key" },
    {
      "id": "swift.cryptokit.ec-keygen",
      "pattern": "\\b(?<curve>P256|P384|P521)\\s*\\.\\s*(?<api>Signing|KeyAgreement)\\s*\\.\\s*PrivateKey\\s*\\(\\s*\\)",
      "template": "{api}",
      "map": { "signing": "ECDSA", "keyagreement": "ECDH" },
      "functions": ["keygen"],
      "key": "private-key"
    },
    {
      "id": "swift.cryptokit.25519-keygen",
      "pattern": "\\bCurve25519\\s*\\.\\s*(?<api>Signing|KeyAgreement)\\s*\\.\\s*PrivateKey\\s*\\(\\s*\\)",
      "template": "{api}",
      "map": { "signing": "Ed25519", "keyagreement": "X25519" },
      "functions": ["keygen"],
      "key": "private-key"
    },
    { "id": "swift.cryptokit.ecdsa", "pattern": "\\b(?<curve>P256|P384|P521)\\s*\\.\\s*Signing\\b", "algorithm": "ECDSA", "functions": ["sign", "verify"] },
    { "id": "swift.cryptokit.ecdh", "pattern": "\\b(?<curve>P256|P384|P521)\\s*\\.\\s*KeyAgreement\\b", "algorithm": "ECDH", "functions": ["other"] },
    { "id": "swift.cryptokit.ed25519", "pattern": "\\bCurve25519\\s*\\.\\s*Signing\\b", "algorithm": "Ed25519", "functions": ["sign", "verify"] },
    { "id": "swift.cryptokit.x25519", "pattern": "\\bCurve25519\\s*\\.\\s*KeyAgreement\\b", "algorithm": "X25519", "functions": ["other"] },
    { "id": "swift.commoncrypto.digest", "pattern": "\\bCC_(?<name>MD5|SHA1|SHA224|SHA256|SHA384|SHA512)\\s*\\(", "functions": ["digest"] },
    { "id": "swift.commoncrypto.hmac", "pattern": "\\bkCCHmacAlg(?<name>MD5|SHA1|SHA224|SHA256|SHA384|SHA512)\\b", "template": "HMAC-{name}", "functions": ["tag"] },
    {
      "id": "swift.commoncrypto.cipher",
      "pattern": "\\bkCCAlgorithm(?<name>AES128|AES|DES|3DES|CAST|RC4|RC2|Blowfish)\\b",
      "map": { "cast": "CAST5" },
      "functions": ["encrypt", "decrypt"]
    },
    { "id": "swift.commoncrypto.ecb", "kind": "mode", "pattern": "\\bkCCOption(?<mode>ECB)Mode\\b" },
    {
      "id": "swift.security.keytype",
      "pattern": "\\bkSecAttrKeyType(?<name>RSA|ECSECPrimeRandom|EC)\\b",
      "map": { "ecsecprimerandom": "EC" },
      "functions": ["keygen"]
    },
    { "id": "swift.security.keysize", "kind": "keysize", "pattern": "\\bkSecAttrKeySizeInBits[^:\\n]*:\\s*{SIZE}" },
    { "id": "swift.cryptoswift.block-cipher", "pattern": "\\b(?<name>AES|Blowfish)\\s*\\(\\s*key\\s*:(?=[^\\n]*?\\bblockMode\\s*:\\s*(?<mode>CBC|GCM|CTR|ECB|CFB|OFB|PCBC|CCM|OCB)\\b)?", "functions": ["encrypt", "decrypt"] },
    { "id": "swift.cryptoswift.stream-cipher", "pattern": "\\b(?<name>XChaCha20|ChaCha20|Rabbit)\\s*\\(\\s*key\\s*:", "functions": ["encrypt", "decrypt"] },
    { "id": "swift.cryptoswift.digest", "pattern": "\\bDigest\\s*\\.\\s*(?<name>md5|sha1|sha224|sha256|sha384|sha512)\\s*\\(", "functions": ["digest"] },
    { "id": "swift.cryptoswift.digest-extension", "pattern": "\\.\\s*(?<name>md5|sha1|sha224|sha256|sha384|sha512)\\s*\\(\\s*\\)", "functions": ["digest"] },
    { "id": "swift.cryptoswift.sha3", "pattern": "\\bsha3\\s*\\(\\s*\\.\\s*(?<name>sha224|sha256|sha384|sha512|keccak224|keccak256|keccak384|keccak512)\\s*\\)", "map": {"sha224": "SHA3-224", "sha256": "SHA3-256", "sha384": "SHA3-384", "sha512": "SHA3-512", "keccak224": "Keccak-224", "keccak256": "Keccak-256", "keccak384": "Keccak-384", "keccak512": "Keccak-512"}, "functions": ["digest"] },
    { "id": "swift.cryptoswift.hmac", "pattern": "\\bHMAC\\s*\\(\\s*key\\s*:[^\\n]*?\\bvariant\\s*:\\s*\\.\\s*(?:sha2\\s*\\(\\s*\\.\\s*)?(?<name>md5|sha1|sha224|sha256|sha384|sha512)\\b", "template": "HMAC-{name}", "functions": ["tag"] },
    { "id": "swift.cryptoswift.kdf", "pattern": "\\b(?:PKCS5\\s*\\.\\s*)?(?<name>PBKDF2|PBKDF1|Scrypt|HKDF)\\s*\\(\\s*(?:password|key)\\s*:", "functions": ["keyderive"] },
    { "id": "swift.cryptoswift.mac", "pattern": "\\b(?<name>Poly1305|CBCMAC|CMAC)\\s*\\(\\s*key\\s*:", "map": {"cbcmac": "CBC-MAC"}, "functions": ["tag"] },
    { "id": "swift.cryptoswift.rsa", "pattern": "\\bRSA\\s*\\(\\s*keySize\\s*:\\s*{SIZE}", "algorithm": "RSA", "functions": ["keygen"], "key": "private-key" },
    { "id": "swift.tls.version", "pattern": "\\btls_protocol_version_t\\s*\\.\\s*(?<name>TLSv10|TLSv11|TLSv12|TLSv13)\\b", "functions": ["other"] }
  ]
}
