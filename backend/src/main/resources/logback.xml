<configuration>
  <!-- Logs applicatifs sur la sortie standard (collectés par Docker / Kubernetes). -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} [%X{analysisId:-}] - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Un journal par analyse : DATA_DIR/analyses/<id>/analysis.log (consultable depuis l'interface). -->
  <appender name="ANALYSIS" class="com.chiffrium.infrastructure.logging.AnalysisFileAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.eclipse.jetty" level="WARN"/>
  <logger name="io.javalin" level="WARN"/>
  <logger name="org.eclipse.jgit" level="WARN"/>

  <root level="${LOG_LEVEL:-INFO}">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ANALYSIS"/>
  </root>
</configuration>
